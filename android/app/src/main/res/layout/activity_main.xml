<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F6F7FB">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Бот по расписанию" android:textSize="30sp" android:textStyle="bold" android:textColor="#1F2937"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Управление публикациями в Telegram" android:textSize="16sp" android:textColor="#667085" android:paddingBottom="18dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#FFFFFF" android:padding="18dp">
<TextView android:id="@+id/statusTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Статус: настройка не завершена" android:textSize="18sp" android:textStyle="bold" android:textColor="#B54708"/>
<TextView android:id="@+id/statusDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Заполни подключения и расписание" android:textColor="#667085" android:paddingTop="6dp"/>
</LinearLayout>
<Button android:id="@+id/githubScreen" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1. Подключение GitHub" android:textAllCaps="false" android:layout_marginTop="14dp"/>
<Button android:id="@+id/telegramScreen" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="2. Telegram-бот и чаты" android:textAllCaps="false"/>
<Button android:id="@+id/aiScreen" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="3. AI-провайдер и модель" android:textAllCaps="false"/>
<Button android:id="@+id/scheduleScreen" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="4. Расписание отправки" android:textAllCaps="false"/>
<Button android:id="@+id/historyScreen" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="История и отчёт" android:textAllCaps="false"/>
<Button android:id="@+id/sendNow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Отправить сейчас онлайн" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#6D28D9" android:layout_marginTop="12dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Репозиторий подключён автоматически: ajtnazarovasirin-wq/telegram-auto-bot-1" android:textSize="12sp" android:textColor="#98A2B3" android:paddingTop="16dp"/>
</LinearLayout></ScrollView>
